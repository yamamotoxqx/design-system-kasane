{
  "name": "design-system-kasane",
  "version": "1.0.0",
  "description": "Kasane: a design system with layered surfaces and nine selectable accent palettes.",
  "type": "module",
  "private": true,
  "exports": {
    "./stylelint": "./lint/stylelint.js",
    "./kasane.css": "./v1/kasane.css",
    "./tokens.json": "./v1/tokens.json"
  },
  "files": [
    "v1",
    "lint"
  ],
  "scripts": {
    "build": "node tools/gen.cjs && python3 tools/build_site.py",
    "test": "node test/run.js",
    "dist": "rm -rf dist && mkdir dist && cp -r site/. dist/ && cp -r llms.txt _headers LICENSE v1 dist/ && npm pack ./lint --pack-destination dist/v1 --silent",
    "lighthouse": "node tools/lighthouse-site.mjs",
    "fonts": "python3 tools/fonts.py",
    "icons": "python3 tools/icons.py"
  },
  "peerDependencies": {
    "stylelint": ">=16"
  },
  "devDependencies": {
    "@fontsource/line-seed-jp": "^5.3.2",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "htmlparser2": "^12.0.0",
    "lighthouse": "^13.6.0",
    "line-seed-jp": "^0.0.5",
    "lucide-static": "^1.71.0",
    "sharp": "^0.35.5",
    "ssim.js": "^3.5.0",
    "stylelint": "^16.10.0"
  },
  "license": "MIT"
}
