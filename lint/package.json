{
  "name": "kasane-lint",
  "version": "1.1.0",
  "description": "Automatic checks for the Kasane design system: Stylelint rules (CSS), kasane-check (HTML), kasane-image (image optimisation with SSIM), kasane-lighthouse (Lighthouse minimum scores).",
  "type": "module",
  "main": "stylelint.js",
  "exports": {
    "./stylelint": "./stylelint.js",
    "./plugin": "./plugin.js",
    "./check": "./check.js",
    "./package.json": "./package.json",
    "./image": "./image.js",
    "./lighthouse": "./lighthouse.js"
  },
  "files": [
    "stylelint.js",
    "plugin.js",
    "check.js",
    "image.js",
    "lighthouse.js",
    "data"
  ],
  "license": "MIT",
  "peerDependencies": {
    "stylelint": ">=16",
    "lighthouse": ">=12"
  },
  "bin": {
    "kasane-check": "check.js",
    "kasane-image": "image.js",
    "kasane-lighthouse": "lighthouse.js"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "stylelint": {
      "optional": true
    },
    "lighthouse": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "sharp": "^0.35.0",
    "ssim.js": "^3.5.0"
  }
}
